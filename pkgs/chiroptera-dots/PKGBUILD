# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-dots
_srcname=chiroptera-dots
pkgver=0.1.10
_tag=v0.1.10
pkgrel=2
pkgdesc='ChiropteraOS dotfiles: Hyprland, Chiroptera Shell, fish, foot, fastfetch'
arch=('any')
url='https://github.com/george-leonard314/chiroptera-dots'
license=('GPL-3.0-only')
makedepends=('librsvg')
# ttf-hack-nerd: foot, GTK, fontconfig and the Hyprland group bar all name Hack;
# without it foot falls back to proportional Noto Sans and every cell is too wide.
# imagemagick: fastfetch renders the Sixel logo through it; without it every
# terminal shows Arch's ASCII art instead.
depends=('hyprland' 'chiroptera-shell' 'fish' 'foot' 'fastfetch' 'btop' 'starship'
         'imagemagick' 'ttf-hack-nerd')
optdepends=('thunar: file manager used by the file-explorer keybind'
            'kmg: notes, bound to the notes special workspace'
            'superproductivity: todo, bound to the todo special workspace')
provides=('chiroptera-dots')
# Override with a local clone for development builds, e.g. file:///home/g/git/chiroptera-dots
_repo="${CHIROPTERA_DOTS_REPO:-$url.git}"
source=("${_srcname}::git+${_repo}#tag=${_tag}")
sha256sums=('SKIP')

package() {
  cd "${_srcname}"
  # Pristine tree the installer copies from.
  install -dm755 "$pkgdir/usr/share/chiroptera/dots"
  cp -a config/. "$pkgdir/usr/share/chiroptera/dots/"
  # New users get it through /etc/skel.
  install -dm755 "$pkgdir/etc/skel/.config" "$pkgdir/etc/skel/.local/share/chiroptera/branding"
  cp -a config/. "$pkgdir/etc/skel/.config/"
  # Files the repo keeps out of git as personal or generated, but which
  # hyprland.conf sources: give a fresh account working stand-ins. The shell
  # regenerates scheme/current.conf from the wallpaper on first start.
  local tree
  for tree in "$pkgdir/usr/share/chiroptera/dots" "$pkgdir/etc/skel/.config"; do
    [[ -e $tree/hypr/scheme/current.conf ]] \
      || install -m644 "$tree/hypr/scheme/default.conf" "$tree/hypr/scheme/current.conf"
    [[ -e $tree/hypr/monitors.conf ]] \
      || printf '# Every monitor at its preferred mode; edit with nwg-displays.\nmonitor = , preferred, auto, 1\n' \
         | install -m644 /dev/stdin "$tree/hypr/monitors.conf"
    [[ -e $tree/hypr/hyprland/user.conf ]] \
      || printf '# Personal Hyprland overrides; sourced last.\n' \
         | install -m644 /dev/stdin "$tree/hypr/hyprland/user.conf"
  done
  install -dm755 "$pkgdir/usr/share/chiroptera/branding"
  install -m644 branding/*.svg "$pkgdir/usr/share/chiroptera/branding/"
  # config.toml points the control-center button at
  # ~/.local/share/chiroptera/branding/chiroptera-bat-icon.svg. The dev
  # installer copies the marks there; a fresh account needs the same copies or
  # the bar shows the shell's default glyph instead of the bat.
  install -m644 branding/*.svg "$pkgdir/etc/skel/.local/share/chiroptera/branding/"
  install -Dm644 branding/wallpapers/chiroptera-default.png \
    "$pkgdir/usr/share/backgrounds/chiroptera/chiroptera-default.png"
  # fastfetch's logo is a template the shell re-renders for each palette; a
  # fresh account has none yet, and fastfetch then falls back to Arch's ASCII
  # art. Render the Chiroptera palette's version at build time so the logo is
  # right from the first terminal.
  sed -e 's|{{colors.primary.default.hex}}|#6778e4|' \
      -e 's|{{colors.tertiary.default.hex}}|#be66cc|' \
      config/chiroptera/templates/fastfetch-logo.svg >"$srcdir/fastfetch-logo.svg"
  rsvg-convert -w 480 "$srcdir/fastfetch-logo.svg" \
    -o "$pkgdir/etc/skel/.local/share/chiroptera/branding/fastfetch-logo.png"
  install -Dm755 bin/chiroptera-super-tap "$pkgdir/usr/bin/chiroptera-super-tap"
  install -Dm755 bin/chiroptera-toggle    "$pkgdir/usr/bin/chiroptera-toggle"
  install -Dm755 bin/chiroptera-browser   "$pkgdir/usr/bin/chiroptera-browser"
  # Shadow the launcher entries dependencies install; see
  # share/applications/README.md in chiroptera-dots.
  install -Dm644 -t "$pkgdir/etc/skel/.local/share/applications" share/applications/*.desktop
  install -Dm755 bin/chiroptera-apps      "$pkgdir/usr/bin/chiroptera-apps"
  install -Dm755 bin/chiroptera-blackarch "$pkgdir/usr/bin/chiroptera-blackarch"
  install -Dm644 -t "$pkgdir/usr/share/chiroptera" packages/apps.txt packages/apps-blackarch.txt
  install -Dm755 install.sh               "$pkgdir/usr/bin/chiroptera-dots"
  install -Dm644 README.md  "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
}
