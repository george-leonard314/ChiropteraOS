# chiroptera-greeter replaces the greeter package ChiropteraOS shipped before
# it (named in legacy-names.sh). That package kept its state, the greetd
# command line and the passwordless-sync rule under its own name, and
# chiroptera-greeter reads none of them, so carry them over first. Each step
# does nothing once done, and nothing on a machine that never had it.

_new_state=/var/lib/chiroptera-greeter

# Settings and the synced appearance: move the old state directory, keeping
# its owner and mode, unless the new one already holds something.
_migrate_state() {
  local old=/var/lib/$LEGACY_GREETER
  [[ -d $old && ! -L $old ]] || return 0
  if [[ -e $_new_state ]] && ! rmdir "$_new_state" 2>/dev/null; then
    echo "==> $_new_state already exists; left $old as it was"
    return 0
  fi
  mv "$old" "$_new_state"
  echo "==> moved the login screen's settings from $old to $_new_state"
}

# greetd runs whatever command config.toml names. The old session wrapper is
# gone with its package, so without this the login screen would not start.
_migrate_greetd() {
  local f=/etc/greetd/config.toml
  [[ -f $f ]] && grep -q -e "$LEGACY_GREETER" -e "$LEGACY_GREETER_ENV_PREFIX" "$f" || return 0
  cp -a "$f" "$f.pre-chiroptera-greeter"
  sed -i -e "s|$LEGACY_GREETER|chiroptera-greeter|g" \
         -e "s|$LEGACY_GREETER_ENV_PREFIX|CHIROPTERA_GREETER_|g" "$f"
  echo "==> $f now starts chiroptera-greeter (the old file is $f.pre-chiroptera-greeter)"
}

# The old rule authorizes a Polkit action that no longer exists, for the
# accounts its CLI recorded on the metadata line:
#   // metadata: {"format": 1, "helper": "...", "users": ["alice", "bob"]}
# Authorize the same accounts for chiroptera-greeter's action, then drop the
# old rule, so sync from the shell stays passwordless where it was.
_migrate_sync_rule() {
  local rule=/etc/polkit-1/rules.d/$LEGACY_GREETER_SYNC_RULE
  [[ -e $rule ]] || return 0
  local list user users=() failed=()
  list=$(sed -n 's|^// metadata: .*"users": *\[\([^]]*\)\].*|\1|p' "$rule" | head -n 1)
  IFS=, read -r -a users <<<"$list"
  for user in "${users[@]}"; do
    user=${user//[\" ]/}
    [[ -n $user ]] || continue
    if [[ $user =~ ^[a-z_][a-z0-9_.-]*\$?$ ]] \
        && /usr/bin/chiroptera-greeter passwordless-sync enable "$user" >/dev/null 2>&1; then
      echo "==> passwordless sync from the shell stays enabled for $user"
    else
      failed+=("$user")
    fi
  done
  rm -f "$rule"
  echo "==> removed the old login screen's rule $rule"
  if ((${#failed[@]} > 0)); then
    echo "==> could not carry passwordless sync over for: ${failed[*]}"
    echo "    to enable it again: sudo chiroptera-greeter passwordless-sync enable USER"
  fi
}

_migrate() {
  local names=/usr/share/chiroptera-greeter/legacy-names.sh
  [[ -r $names ]] || return 0
  # shellcheck source=../../legacy/names.sh
  . "$names"
  _migrate_state
  _migrate_greetd
  _migrate_sync_rule
}

# Patch greetd's PAM stack for XDG_RUNTIME_DIR, prepare the state directory and
# write greeter.toml and sync.toml where missing. Its own greetd hint is for
# plain installs; chiroptera-boot's command is the one to use here.
_setup() {
  [[ -x /usr/bin/chiroptera-greeter-apply-appearance ]] || return 0
  CHIROPTERA_GREETER_SESSION_BIN=/usr/bin/chiroptera-greeter-session \
    /usr/share/chiroptera-greeter/setup_greeter_system.sh >/dev/null || true
}

post_install() {
  _migrate
  _setup
}

post_upgrade() {
  _migrate
  _setup
  echo "==> chiroptera-greeter was updated; it takes effect the next time greetd starts it."
}
