# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-calamares-config
pkgver=0.1.2
pkgrel=1
pkgdesc='ChiropteraOS installer: Calamares settings, modules and branding'
arch=('any')
url='https://github.com/george-leonard314/ChiropteraOS'
license=('MIT')
# BlackArch's calamares omits runtime tools cachyos-calamares pulled in:
# rsync (unpackfs), gptfdisk, dmidecode, upower, qt6-imageformats.
depends=('calamares' 'chiroptera-hwd' 'chiroptera-themes' 'qt6-wayland' 'sudo'
         'rsync' 'gptfdisk' 'dmidecode' 'upower' 'qt6-imageformats')

# The files live in this repository's calamares/ directory, two levels up.
package() {
  local src="$startdir/../../calamares"
  install -Dm644 "$src/settings.conf" "$pkgdir/etc/calamares/settings.conf"
  install -Dm644 "$src/chiroptera-netinstall.yaml" "$pkgdir/etc/calamares/chiroptera-netinstall.yaml"
  install -Dm644 -t "$pkgdir/etc/calamares/modules" "$src"/modules/*.conf
  install -Dm755 -t "$pkgdir/etc/calamares/scripts" "$src"/scripts/*
  # Our own job modules; settings.conf lists this directory in modules-search.
  local mod
  for mod in "$src"/job-modules/*/; do
    install -Dm644 -t "$pkgdir/usr/share/chiroptera/calamares/modules/$(basename "$mod")" "$mod"/*
  done
  install -Dm644 -t "$pkgdir/usr/share/calamares/branding/chiroptera" "$src"/branding/chiroptera/*
  install -Dm755 "$src/chiroptera-install" "$pkgdir/usr/bin/chiroptera-install"
  install -Dm644 "$src/chiroptera-install.desktop" \
    "$pkgdir/usr/share/applications/chiroptera-install.desktop"
}
