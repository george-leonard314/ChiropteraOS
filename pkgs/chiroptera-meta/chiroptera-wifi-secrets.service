[Unit]
Description=Store 802.1X Wi-Fi passwords system-wide instead of in the keyring
# nm-applet is the secret agent that hands over the keyring copy
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/lib/chiroptera/chiroptera-wifi-secrets
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
