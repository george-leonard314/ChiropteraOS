#!/bin/bash
# Moves 802.1X passwords (eduroam and the like) out of the desktop keyring and
# into NetworkManager's own profile. The eduroam installer and nm-applet save
# them as agent-owned (password-flags 1), so NetworkManager can only connect
# once the session's secret agent answers: after resume it sits in need-auth,
# and any RADIUS reject turns into a password prompt.
#
# Agent-owned secrets are handed only to the user whose agent holds them, so
# this runs in the user's session rather than as a root dispatcher script.

set -u

migrate() {
    local uuid type flags pw
    while IFS=: read -r uuid type; do
        [[ $type == 802-11-wireless ]] || continue
        flags=$(nmcli -g 802-1x.password-flags connection show "$uuid" 2>/dev/null) || continue
        # 1 = agent-owned; anything else (system, not-saved, not-required) is left alone
        [[ $flags == 1 ]] || continue
        # Only when the agent actually answers: a locked keyring gives nothing
        pw=$(nmcli -s -g 802-1x.password connection show "$uuid" 2>/dev/null) || continue
        [[ -n $pw ]] || continue
        unset pw
        # nmcli modify fetches the current secrets and sends them back with the
        # profile, so flipping the flag alone moves the password across without
        # it ever appearing in argv.
        nmcli connection modify "$uuid" 802-1x.password-flags 0 &&
            echo "stored 802.1X password system-wide for $uuid"
    done < <(nmcli -t -f UUID,TYPE connection show)
}

migrate
[[ ${1:-} == --once ]] && exit 0

# A new profile only gets its password once it has connected, so check again
# whenever a device connects.
nmcli monitor | while read -r line; do
    [[ $line == *": connected"* ]] && migrate
done
