# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-meta
pkgver=0.1.6
pkgrel=1
pkgdesc='Everything a ChiropteraOS desktop needs'
arch=('any')
url='https://github.com/george-leonard314/ChiropteraOS'
license=('MIT')
depends=(
  # Shell and dotfiles
  'chiroptera-shell' 'chiroptera-dots'
  # Compositor and session
  'hyprland' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk' 'uwsm'
  # Terminal and shell tooling
  'foot' 'fish' 'starship' 'eza' 'zoxide' 'fzf' 'jq' 'ripgrep' 'bat'
  # System tools the config and keybinds use
  'btop' 'fastfetch' 'wl-clipboard' 'cliphist' 'hyprpicker' 'grim' 'slurp'
  'brightnessctl' 'ddcutil' 'trash-cli' 'inotify-tools' 'polkit-gnome' 'gnome-keyring' 'libnotify'
  # App launching and input tools the keybinds route through
  # app2unit is vendored from the AUR into pkgs/app2unit; see docs/repository.md.
  'app2unit' 'ydotool' 'qps' 'pavucontrol'
  # Package search and install in the terminal
  # pacseek is vendored from the AUR into pkgs/pacseek; see docs/repository.md.
  'pacseek'
  # Battery and power modes in the shell's Power panel: chiroptera-shell only
  # optdepends on upower, and without it the panel is empty
  'upower' 'power-profiles-daemon'
  # Audio, network, bluetooth
  'pipewire' 'pipewire-pulse' 'pipewire-alsa' 'wireplumber' 'networkmanager' 'bluez' 'bluez-utils'
  # File manager and the pieces that make it useful: archives, thumbnails,
  # trash and mounting. Thunar's terminal is set to foot in chiroptera-dots.
  'thunar' 'thunar-archive-plugin' 'file-roller' 'tumbler' 'gvfs' 'gvfs-mtp'
  # Documents, Pictures and the other home folders: the installer creates them
  # for the new account, and its user service keeps them for later ones
  'xdg-user-dirs'
  # Monitor layout editor, and an editor that is always there
  'nwg-displays' 'nano'
  # Look and feel
  # Repo names, not the AUR -kde variants: those provide these, so both satisfy it.
  'adw-gtk-theme' 'papirus-icon-theme' 'qt5ct' 'qt6ct'
  'ttf-hack-nerd' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji'
  'ttf-material-symbols-variable'
  # Sound effects used by the fish error hook
  'sound-theme-freedesktop' 'libpulse'
  # Notes: KMG, the SiYuan rebrand from pkgs/kmg, bound to the notes special workspace
  'kmg'
)
# firefox and code are deliberately not declared: no profile or configuration
# is invested in either, so they are not part of the ChiropteraOS package set.
optdepends=('superproductivity: todo'
            'noctalia-greeter: greetd login screen themed by the shell'
)
provides=('chiroptera-meta')
