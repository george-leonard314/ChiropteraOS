# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-meta
pkgver=0.1.11
pkgrel=1
pkgdesc='Everything a ChiropteraOS desktop needs'
arch=('any')
url='https://github.com/george-leonard314/ChiropteraOS'
license=('MIT')
depends=(
  # Shell and dotfiles
  'chiroptera-shell' 'chiroptera-dots'
  # Compositor and session
  'hyprland' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk' 'uwsm'
  # Terminal and shell tooling
  'foot' 'fish' 'starship' 'eza' 'zoxide' 'fzf' 'jq' 'ripgrep' 'bat'
  # System tools the config and keybinds use
  'btop' 'fastfetch' 'wl-clipboard' 'cliphist' 'hyprpicker' 'grim' 'slurp'
  'brightnessctl' 'ddcutil' 'trash-cli' 'inotify-tools' 'polkit-gnome' 'gnome-keyring' 'libnotify'
  # App launching and input tools the keybinds route through
  # app2unit is vendored from the AUR into pkgs/app2unit; see docs/repository.md.
  'app2unit' 'ydotool' 'qps' 'pavucontrol'
  # Package search and install in the terminal
  # pacseek is vendored from the AUR into pkgs/pacseek; see docs/repository.md.
  'pacseek'
  # Battery and power modes in the shell's Power panel: chiroptera-shell only
  # optdepends on upower, and without it the panel is empty
  'upower' 'power-profiles-daemon'
  # Audio, network, bluetooth
  'pipewire' 'pipewire-pulse' 'pipewire-alsa' 'wireplumber' 'networkmanager' 'bluez' 'bluez-utils'
  # File manager and the pieces that make it useful: archives, thumbnails,
  # trash and mounting. Thunar's terminal is set to foot in chiroptera-dots.
  'thunar' 'thunar-archive-plugin' 'file-roller' 'tumbler' 'gvfs' 'gvfs-mtp'
  # Image viewer and video player: without them, pictures open in GIMP or
  # ImageMagick's display and videos in the browser or nothing at all
  'loupe' 'celluloid'
  # Documents, Pictures and the other home folders: the installer creates them
  # for the new account, and its user service keeps them for later ones
  'xdg-user-dirs'
  # Monitor layout editor, and an editor that is always there
  'nwg-displays' 'nano'
  # Look and feel
  # Repo names, not the AUR -kde variants: those provide these, so both satisfy it.
  'adw-gtk-theme' 'papirus-icon-theme' 'qt5ct' 'qt6ct'
  'ttf-hack-nerd' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji'
  'ttf-material-symbols-variable'
  # Sound effects used by the fish error hook
  'sound-theme-freedesktop' 'libpulse'
  # Notes: KMG, the SiYuan rebrand released by github.com/george-leonard314/kmg,
  # bound to the notes special workspace
  'kmg'
)
# firefox and code are deliberately not declared: no profile or configuration
# is invested in either, so they are not part of the ChiropteraOS package set.
optdepends=('superproductivity: todo'
            'zen-browser-bin: the browser that follows the wallpaper palette'
            'noctalia-greeter: greetd login screen themed by the shell'
)
provides=('chiroptera-meta')
# chiroptera-wifi-secrets 0.1.0 and chiroptera-zen-theme 0.1.0 shipped the
# files below on their own; they live here now.
replaces=('chiroptera-wifi-secrets' 'chiroptera-zen-theme')
conflicts=('chiroptera-wifi-secrets' 'chiroptera-zen-theme')
# Besides the dependencies, two small things ship here:
# - eduroam and other 802.1X passwords move from the keyring into
#   NetworkManager, so resume and RADIUS hiccups stop asking for them;
# - Zen Browser follows the shell's wallpaper palette live, without a restart.
#   zen-browser-bin comes from [cachyos], which the image's repositories lack,
#   so it is only an optdepend; without Zen the files are inert. The palette
#   CSS comes from the shell's zen-browser template, enabled in chiroptera-dots.
# All files sit beside this PKGBUILD and change with this repository, so there
# is no checksum to keep -- bump pkgver whenever they change.
source=('chiroptera-wifi-secrets' 'chiroptera-wifi-secrets.service'
        'autoconfig.js' 'chiroptera-zen.cfg')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/chiroptera-wifi-secrets" "$pkgdir/usr/lib/chiroptera/chiroptera-wifi-secrets"
    install -Dm644 "$srcdir/chiroptera-wifi-secrets.service" \
        "$pkgdir/usr/lib/systemd/user/chiroptera-wifi-secrets.service"
    # Enabled for every user by the package itself, so existing accounts get
    # it without running systemctl.
    install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s ../chiroptera-wifi-secrets.service \
        "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/chiroptera-wifi-secrets.service"

    # Gecko reads autoconfig only from the install directory. zen-browser-bin
    # owns neither file, so its upgrades leave them in place.
    install -Dm644 "$srcdir/autoconfig.js" "$pkgdir/opt/zen-browser-bin/defaults/pref/autoconfig.js"
    install -Dm644 "$srcdir/chiroptera-zen.cfg" "$pkgdir/opt/zen-browser-bin/chiroptera-zen.cfg"
}
