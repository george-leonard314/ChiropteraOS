# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-boot
pkgver=0.1.2
pkgrel=1
pkgdesc='ChiropteraOS boot and login: Dark Matter GRUB theme, branded Noctalia greeter, the ChiropteraOS session'
arch=('any')
url='https://github.com/george-leonard314/ChiropteraOS'
# Dark Matter (boot/grub/darkmatter) is GPL-3.0 by VandalByte; the rest is MIT.
license=('GPL-3.0-only' 'MIT')
depends=('noctalia-greeter' 'chiroptera-dots' 'hyprland')
optdepends=('grub: the Dark Matter boot menu theme')
install=chiroptera-boot.install
# Called chiroptera-themes up to 0.1.1; the name said nothing about what it holds.
replaces=('chiroptera-themes')
conflicts=('chiroptera-themes')
provides=('chiroptera-themes')

# The files live in this repository's boot/ directory, two levels up.
package() {
  local src="$startdir/../../boot"

  install -dm755 "$pkgdir/usr/share/grub/themes"
  cp -r "$src/grub/darkmatter" "$pkgdir/usr/share/grub/themes/darkmatter"
  find "$pkgdir/usr/share/grub/themes/darkmatter" -type f -exec chmod 644 {} +
  install -Dm644 "$src/grub/darkmatter/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.darkmatter"

  # The greeter looks for noctalia.svg and fonts/ in the directory named by
  # NOCTALIA_GREETER_ASSETS_DIR; the greetd command sets it to this bundle.
  local assets="$pkgdir/usr/share/chiroptera/greeter/assets"
  install -Dm644 "$src/greeter/assets/noctalia.svg" "$assets/noctalia.svg"
  ln -s /usr/share/noctalia-greeter/assets/fonts "$assets/fonts"
  install -Dm644 -t "$pkgdir/usr/share/chiroptera/greeter" \
    "$src/greeter/sync.toml" "$src/greeter/greeter.toml"
  install -Dm644 "$src/greeter/chiroptera-greeter.conf" \
    "$pkgdir/usr/lib/sysusers.d/chiroptera-greeter.conf"

  # The "ChiropteraOS" session: Hyprland with DisplayLink's evdi cards kept out
  # of AQ_DRM_DEVICES. greeter.toml makes it the login screen's default.
  install -Dm755 "$src/session/chiroptera-session" "$pkgdir/usr/bin/chiroptera-session"
  install -Dm644 "$src/session/chiroptera.desktop" \
    "$pkgdir/usr/share/wayland-sessions/chiroptera.desktop"
}
