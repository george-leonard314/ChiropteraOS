# Maintainer: George (ChiropteraOS)

pkgname=chiroptera-zen-theme
pkgver=0.1.0
pkgrel=1
pkgdesc='Zen Browser follows the Chiroptera Shell wallpaper palette live, without a restart'
arch=('any')
url='https://github.com/george-leonard314/ChiropteraOS'
license=('MIT')
# chiroptera-meta carries this into the image, and the installer copies the
# image, so it is on every install whichever browser was chosen: without Zen
# the files are inert. zen-browser-bin is only an optdepend because it comes
# from [cachyos], which the image's repositories lack. The palette CSS comes
# from the shell's zen-browser template, enabled in chiroptera-dots 0.1.14.
optdepends=('zen-browser-bin: the browser this recolors')
# Both files sit beside this PKGBUILD and change with this repository, so there
# is no checksum to keep -- bump pkgver whenever they change, since CI skips any
# version it has already built.
source=('autoconfig.js' 'chiroptera-zen.cfg')
sha256sums=('SKIP' 'SKIP')

package() {
    # Gecko reads autoconfig only from the install directory. zen-browser-bin
    # owns neither file, so its upgrades leave them in place.
    install -Dm644 "$srcdir/autoconfig.js" "$pkgdir/opt/zen-browser-bin/defaults/pref/autoconfig.js"
    install -Dm644 "$srcdir/chiroptera-zen.cfg" "$pkgdir/opt/zen-browser-bin/chiroptera-zen.cfg"
}
